rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles and data
    match /users/{userId} {
      // Allow users to read/write their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Courses subcollection - allow public read for cross-app integration
      match /courses/{courseId} {
        // Allow read for anyone (cross-app integration)
        // Write only for owner
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Events subcollection (schedule events) - allow public read for cross-app integration
      match /events/{eventId} {
        // Allow read for anyone (cross-app integration)
        // Write only for owner
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Assignments subcollection - allow public read for cross-app integration
      match /assignments/{assignmentId} {
        // Allow read for anyone (cross-app integration)
        // Write only for owner
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Friends subcollection - private
      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Friend requests subcollection
      match /friend_requests/{requestId} {
        // Allow reading own friend requests
        allow read: if request.auth != null && request.auth.uid == userId;
        // Allow anyone authenticated to create a friend request to this user
        allow create: if request.auth != null;
        // Allow the recipient to update/delete (accept/decline)
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Allow querying users by email for cross-app lookup
    // This allows finding a user's document ID by their email
    match /users/{userId} {
      allow list: if true;
    }
  }
}

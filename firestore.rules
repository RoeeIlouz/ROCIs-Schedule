rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles and data
    match /users/{userId} {
      // Allow read for synergy across ROCIs apps (Tasks, Widget, Web); write strictly protected
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Courses subcollection - read for ecosystem synergy
      match /courses/{courseId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Events subcollection (schedule events) - read for ecosystem synergy
      match /events/{eventId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Assignments subcollection - read for ecosystem synergy
      match /assignments/{assignmentId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Semesters subcollection - read for ecosystem synergy
      match /semesters/{semesterId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Friends subcollection - private
      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Friend requests subcollection
      match /friend_requests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

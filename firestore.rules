rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profiles and data are private to their owner. ROCIs Tasks reads a
    // user's schedule while signed in to this project as that user.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /courses/{courseId} {
        allow read, write: if isOwner(userId);
      }

      match /events/{eventId} {
        allow read, write: if isOwner(userId);
      }

      match /assignments/{assignmentId} {
        allow read, write: if isOwner(userId);
      }

      match /semesters/{semesterId} {
        allow read, write: if isOwner(userId);
      }

      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }

      // Owner-only until friend requests are implemented; a cross-user create
      // rule must then require the sender's uid to be request.auth.uid.
      match /friend_requests/{requestId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
